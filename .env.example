GOOGLE_DEPLOY_REDIRECT_URI=https://agentic-web-800515339243.asia-northeast3.run.app/auth/google/callback
# Generate with: python -c 'import secrets; print(secrets.token_hex(32))'
FLASK_SECRET_KEY=

# Cloud Run deployment / Firestore project
GOOGLE_CLOUD_PROJECT=h2gdm-hack26icn-2680
