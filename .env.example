GEMINI_API_KEY=your-api-key
GEMINI_ROOT_MODEL=gemini-3.8-flash
GEMINI_SYNTHESIZER_MODEL=gemini-3.8-flash
GEMINI_EXECUTOR_MODEL=gemini-3.5-flash-lite

# Google Auth Platform: OAuth client type = Web application
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:5055/auth/google/callback
# Generate with: python -c 'import secrets; print(secrets.token_hex(32))'
FLASK_SECRET_KEY=
